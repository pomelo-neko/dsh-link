<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_connect"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="连接中心服务器或节点"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1E3A5F" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:paddingBottom="10dp"
            android:text="通用 APK 不含任何凭据：先导入 hub 管理员给你的连接串/配置文件，或扫描二维码。只在连接或刷新时传输数据。"
            android:textSize="12sp"
            android:textColor="#6B7280" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:text="① 导入连接串"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#374151" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/import_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:textSize="13sp"
                android:text="粘贴导入" />

            <Button
                android:id="@+id/import_file_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:text="文件" />
        </LinearLayout>

        <Button
            android:id="@+id/scan_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:text="扫描二维码（相机）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:paddingBottom="6dp"
            android:text="② 手动连接"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#374151" />

        <EditText
            android:id="@+id/url_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="中心服务器地址，例如 http://192.0.2.10:8790（也支持节点 8787）"
            android:inputType="textUri"
            android:singleLine="true"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/token_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="device token（hub: dshlink hub token new --role device）"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/tunnel_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="通过阿里云 STCP 中转（需先导入隧道配置；端口从 frpc.toml 读取）"
            android:textSize="12sp" />

        <Button
            android:id="@+id/connect_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="连接"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1E3A5F" />

        <TextView
            android:id="@+id/connect_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:textSize="12sp"
            android:textColor="#374151" />

        <TextView
            android:id="@+id/connect_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:textSize="11sp"
            android:textColor="#6B7280" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="连接成功后会自动切回“工作区”页；之后进入会话可以接收消息更新并发送消息。"
            android:textSize="11sp"
            android:textColor="#9CA3AF" />
    </LinearLayout>
</ScrollView>
