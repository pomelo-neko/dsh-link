# ---- runtime scratch ----
test/.tmp/
*.log
node_modules/

# ---- build output (regenerate with scripts/build-bundle.ps1) ----
dist/
android/dist/
android/debug.keystore
android/*.idsig

# ---- vendored third-party frp binaries (download with: node scripts/fetch-vendor.mjs) ----
vendor/frp/windows-amd64/
vendor/frp/linux-amd64/

# ---- Android built-in STCP tunnel: local credentials + downloaded frpc binaries ----
# Template and instructions are tracked in android/tunnel/; the rendered config, certs and
# native libs are not, because they are shared per-deployment credentials / large binaries.
android/app/src/main/assets/tunnel/
android/native/
android/frp-arm64/
android/frp_*.tar.gz

# ---- screenshots (real host names / LAN addresses; kept out of the repo) ----
docs/mobile/screenshots/

# ---- local configs / data dirs ----
dshlink.config.json
.dshlink/
*.local.json

# ---- editors / OS ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
